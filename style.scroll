importOnly
css
 :root { color-scheme: light; --paper: #f8f5ee; --ink: #292d27; --muted: #686b60; --accent: #8b462e; --line: #dcdcd0; }
 * { box-sizing: border-box; }
 body { margin: 0; background: var(--paper); color: var(--ink); -webkit-font-smoothing: antialiased; }
 a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; }
 a:hover { color: var(--accent); }
 a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
 ::selection { background: #e6d9b8; }
 .masthead, main, .site-footer { width: min(100% - 64px, 1000px); margin-inline: auto; }
 .masthead { display: flex; justify-content: space-between; align-items: baseline; padding: 39px 0 29px; border-bottom: 1px solid var(--line); }
 .wordmark { font: 32px Georgia, serif; letter-spacing: -1.5px; text-decoration: none; }
 .wordmark { color: var(--accent); }
 .tagline, .eyebrow, .artist, h2, .site-footer { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
 .tagline { font-size: 13px; color: var(--muted); }
 .entry { padding: 83px 20px 100px; }
 .eyebrow { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin: 0 0 22px; }
 h1 { font: normal clamp(46px, 8vw, 76px)/1.08 Georgia, serif; letter-spacing: -3px; margin: 0 0 20px; }
 .artist { color: var(--muted); font-size: 14px; margin: 0; }
 .entry-header { padding-bottom: 39px; margin-bottom: 44px; border-bottom: 1px solid var(--line); }
 
 h2 { color: var(--muted); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 1.7px; margin: 0 0 15px; }
 .entry > p { font: 19px/1.85 Georgia, serif; margin: 0; }
 .site-footer { border-top: 1px solid var(--line); padding: 25px 0 40px; display: flex; justify-content: space-between; gap: 20px; font-size: 12px; color: var(--muted); }
 .skip { position: absolute; left: 20px; top: -80px; background: var(--paper); padding: 12px; }
 .skip:focus { top: 10px; }
 @media (max-width: 600px) { .masthead, main, .site-footer { width: calc(100% - 40px); } .masthead { padding-top: 25px; } .entry { padding: 55px 20px 64px; } h1 { letter-spacing: -2px; } .entry > p { font-size: 17px; line-height: 1.9; } .site-footer { font-size: 11px; } }
 @media print { body { background: white; } .skip, .site-footer { display: none; } .entry { padding: 30px 20px; }  }
